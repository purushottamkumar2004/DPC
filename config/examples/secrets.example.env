# DPC site secrets (CONTRACTS section 9). Copy to ~/INSIGHTZZ/config/secrets.env, then:
#     chmod 600 ~/INSIGHTZZ/config/secrets.env
# The loader refuses the file if group or others can read it, and refuses CHANGE_ME values.
# Never commit the real file. One KEY=VALUE per line; no spaces around '='.

# Database: a dedicated user with limited rights, never root.
DPC_DB_USER=CHANGE_ME
DPC_DB_PASS=CHANGE_ME

# Mail, sender: graph (Microsoft Graph)
DPC_MS_TENANT_ID=CHANGE_ME
DPC_MS_CLIENT_ID=CHANGE_ME
DPC_MS_CLIENT_SECRET=CHANGE_ME
DPC_MAIL_SENDER=reports@example.com

# Mail, sender: smtp (uses DPC_MAIL_SENDER above as the login)
# DPC_SMTP_PASSWORD=CHANGE_ME

# Daily disk report recipients, comma separated (cleanup)
DPC_DISK_REPORT_TO=name1@example.com,name2@example.com

# MQTT login, only when the broker has auth on (set both or neither)
# DPC_MQTT_USER=CHANGE_ME
# DPC_MQTT_PASS=CHANGE_ME
