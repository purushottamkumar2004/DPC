<BASLER_CAM>
    <!-- Read BY POSITION (CONTRACTS section 3). Do not reorder or remove elements.
         Elements 15 to 19 are optional; an empty element means "use the default",
         so a later element can be set while keeping earlier ones at their default. -->
    <CODE_PATH>/home/USER/INSIGHTZZ/code/workers/frame_capture_basler/</CODE_PATH>
    <LOG_FILE_PATH>/home/USER/INSIGHTZZ/logs/</LOG_FILE_PATH>
    <LOG_BACKUP_COUNT>5</LOG_BACKUP_COUNT>
    <CAM_SERIAL_NO>CHANGE_ME</CAM_SERIAL_NO>
    <CAM_NAME>Basler Camera</CAM_NAME>
    <EXPOSURE>1500</EXPOSURE>
    <FRAME_RATE>4.00</FRAME_RATE>
    <SAVE_LIVE_IMG_PATH>/home/USER/INSIGHTZZ/data/frames/CAM1/live/</SAVE_LIVE_IMG_PATH>
    <UI_PATH>/home/USER/INSIGHTZZ/data/frames/CAM1/UI/</UI_PATH>
    <INF_PATH>/home/USER/INSIGHTZZ/data/frames/CAM1/INF/</INF_PATH>
    <RAW_IMG_PATH>/home/USER/INSIGHTZZ/data/frames/CAM1/RAW_IMAGES/</RAW_IMG_PATH>
    <DB_USER>CHANGE_ME</DB_USER>
    <DB_PASS>CHANGE_ME</DB_PASS>
    <DB_HOST>localhost</DB_HOST>
    <DB_NAME>CHANGE_ME</DB_NAME>
    <TMP_IMG_PATH>/home/USER/INSIGHTZZ/data/frames/CAM1/_tmp/</TMP_IMG_PATH>
    <!-- 16: health table this camera's row lives in (letters, digits, _). Default: tadipatri_health_status_table -->
    <HEALTH_TABLE>CHANGE_ME</HEALTH_TABLE>
    <!-- 17: log file name inside LOG_FILE_PATH. Give each camera its own. Default: FrameCapture_Basler.log -->
    <LOG_FILE_NAME>FrameCapture_CAM1.log</LOG_FILE_NAME>
    <!-- 18: clockwise rotation 0|90|180|270. 0 = none. Default when absent or empty: 90 -->
    <ROTATE_DEG>0</ROTATE_DEG>
    <!-- 19: seconds between repeated health writes while the state is unchanged (a change is written at once). Default: 600 -->
    <HEALTH_INTERVAL_S>600</HEALTH_INTERVAL_S>
</BASLER_CAM>
